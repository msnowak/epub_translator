:80 {
	root * /srv
	encode gzip

	header {
		# Dokument srcdoc podgladu DZIEDZICZY te polityke i obie sie sumuja -
		# obowiazuje czesc wspolna. Dlatego origin API musi byc dopuszczony
		# takze tutaj, inaczej obrazki ksiazki znikna mimo poprawnego
		# metatagu, ktory wstawia PreviewDecorator.
		Content-Security-Policy "default-src 'self'; connect-src 'self' {$API_ORIGIN}; img-src 'self' data: {$API_ORIGIN}; style-src 'self' 'unsafe-inline' {$API_ORIGIN}; font-src 'self' data: {$API_ORIGIN}; frame-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Router dziala po stronie klienta, wiec odswiezenie /projekty/<uuid> musi
	# dostac index.html zamiast 404.
	try_files {path} /index.html
	file_server
}
