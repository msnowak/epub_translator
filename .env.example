# Copy to .env and adjust. Docker Compose reads only a file named ".env".

# Ktory zestaw uslug podnosi "docker compose up". "dev" to praca nad kodem
# (bind mount, serwer Vite), "prod" to zbudowany front i backend bez zaleznosci
# deweloperskich. Polecenie "docker compose --profile prod up" nadpisuje te
# wartosc, wiec nie trzeba jej zmieniac, zeby raz podniesc produkcje.
COMPOSE_PROFILES=dev

APP_ENV=dev
APP_SECRET=change-me

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Address of the API as the BROWSER sees it. Use the same hostname the SPA is
# opened under - "localhost" and "127.0.0.1" are different sites for cookies,
# so mixing them breaks the refresh-token cookie and logs you out on reload.
VITE_API_URL=http://localhost:8000

# Adresy, z ktorych backend przyjmuje zadania przegladarki (regex). Musi
# wedrowac razem z VITE_API_URL powyzej - inaczej po zmianie adresu SPA
# kazde zadanie do API ginie juz na etapie preflightu CORS.
#CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# Ollama server address as seen FROM INSIDE the container.
# "localhost" would point at the container itself, hence host.docker.internal.
# Ollama on the host must listen on an external interface
# (OLLAMA_HOST=0.0.0.0:11434); with the default 127.0.0.1 bind the container
# gets "connection refused".
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=
OLLAMA_TIMEOUT=300
OLLAMA_DEFAULT_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.2

MAX_SEGMENT_CHARS=2000
MAX_TRANSLATION_ATTEMPTS=3
MAX_UPLOAD_SIZE=104857600
TRANSLATION_WORKERS=1

JWT_PASSPHRASE=change-me

# Flaga Secure ciasteczka odswiezania sesji. Nieustawiona (zalecane): profil
# dev spada na REFRESH_COOKIE_SECURE=0 z backend/.env, a profil prod na
# fallback 1 z compose.yaml - bezpiecznie bez zadnej akcji. Ustaw na 0 tylko
# gdy produkcja stoi po zwyklym HTTP pod adresem innym niz localhost.
#REFRESH_COOKIE_SECURE=0
