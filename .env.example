# Copy to .env and adjust. Docker Compose reads only a file named ".env".
APP_ENV=dev
APP_SECRET=change-me

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Ollama server address as seen FROM INSIDE the container.
# "localhost" would point at the container itself, hence host.docker.internal.
# Ollama on the host must listen on an external interface
# (OLLAMA_HOST=0.0.0.0:11434); with the default 127.0.0.1 bind the container
# gets "connection refused".
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=
OLLAMA_TIMEOUT=300
OLLAMA_DEFAULT_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.2

MAX_SEGMENT_CHARS=2000
MAX_UPLOAD_SIZE=104857600
TRANSLATION_WORKERS=1

JWT_PASSPHRASE=change-me
