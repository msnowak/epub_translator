# Skopiuj do .env.local i dostosuj. Compose czyta .env.local przez env_file.
APP_ENV=dev
APP_SECRET=change-me-in-env-local

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Adres serwera Ollama widziany Z WNETRZA kontenera.
# "localhost" wskazywalby na kontener, dlatego host.docker.internal.
# Ollama na hoscie musi nasluchiwac na 0.0.0.0 (OLLAMA_HOST=0.0.0.0:11434),
# przy domyslnym bindzie na 127.0.0.1 kontener dostanie connection refused.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=
OLLAMA_TIMEOUT=300
OLLAMA_DEFAULT_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.2

MAX_SEGMENT_CHARS=2000
MAX_UPLOAD_SIZE=104857600
TRANSLATION_WORKERS=1

JWT_PASSPHRASE=change-me-in-env-local
